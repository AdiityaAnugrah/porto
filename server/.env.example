# Runtime
HOST=127.0.0.1
PORT=3100
REQUEST_TIMEOUT_MS=8000

# CORS: production + local Vite
ALLOWED_ORIGINS=https://adityaanugrah.me,https://www.adityaanugrah.me,http://localhost:5173,http://127.0.0.1:5173

# Cache TTL
SPOTIFY_CACHE_TTL_MS=15000
STEAM_CACHE_TTL_MS=60000
PUBG_CACHE_TTL_MS=300000

# Spotify Web API
# Required scopes for refresh token:
# user-read-currently-playing user-read-recently-played
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Steam Web API
STEAM_API_KEY=
STEAM_ID=
# Optional profile overrides for the Steam card on the About page
STEAM_DISPLAY_NAME=
STEAM_REAL_NAME=
STEAM_PROFILE_URL=
STEAM_AVATAR_URL=

# PUBG Developer API
PUBG_API_KEY=

# Store
STORE_SITE_URL=https://adityaanugrah.me
STORE_API_PUBLIC_URL=https://api.adityaanugrah.me
STORE_ADMIN_PASSWORD=
STORE_PAYMENT_TTL_MINUTES=30
STORE_WARRANTY_HOURS=24
STORE_CHECKOUT_TIMEOUT_MS=11000
STORE_MAX_BODY_BYTES=6291456
STORE_IMAGE_MAX_BYTES=2500000
STORE_DELIVERY_MAX_BYTES=1000000

# Tripay closed payment
TRIPAY_MODE=sandbox
TRIPAY_PAYMENT_METHOD=QRIS
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=

# Gmail SMTP delivery
EMAIL_USER=
EMAIL_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# Invoice sender
# Optional token; if filled, the /invoice page must send this value.
INVOICE_ACCESS_TOKEN=
INVOICE_FROM_EMAIL=
INVOICE_SENDER_NAME=Aditya Anugrah
INVOICE_SENDER_EMAIL=admin@adityaanugrah.me
INVOICE_SENDER_PHONE=+62 813 7943 0432
INVOICE_SENDER_ADDRESS=Indonesia
INVOICE_PAYMENT_INFO=

# R2 uploads from admin panel
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
